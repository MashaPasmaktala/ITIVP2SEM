{
  "name": "itivp-blablacar",
  "version": "2.0.0",
  "description": "Сервис совместных поездок (аналог BlaBlaCar): Express + MongoDB (Mongoose) + React",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "client": "npm run dev --prefix client",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14"
  }
}
