# Скопируйте этот файл в .env  (PowerShell: Copy-Item .env.example .env)

# MongoDB в Docker / локально:
MONGO_URI=mongodb://localhost:27017/blablacar
# MongoDB Atlas (подставьте свои логин, пароль и адрес кластера):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/blablacar?retryWrites=true&w=majority

JWT_SECRET=change_me_to_any_long_random_string
PORT=3000
CLIENT_URL=http://localhost:5173
