<%- include('partials/header', { user: user, title: 'Список поездок' }) %>

<h1>Список поездок</h1>

<% if (trips.length === 0) { %>
  <p>Пока нет ни одной поездки.
    <% if (user && user.role === 'admin') { %>
      <a href="/add">Добавьте первую</a>.
    <% } %>
  </p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Откуда</th>
        <th>Куда</th>
        <th>Дата отправления</th>
        <th>Цена</th>
        <th>Мест</th>
        <th>Водитель</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% trips.forEach(trip => { %>
        <tr>
          <td><%= trip.from %></td>
          <td><%= trip.to %></td>
          <td><%= new Date(trip.departureAt).toLocaleString('ru-RU', {
            day: '2-digit', month: '2-digit', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
          }) %></td>
          <td><%= trip.price %> BYN</td>
          <td><%= trip.seats %></td>
          <td><%= trip.driver ? trip.driver.name : '—' %></td>
          <td><a href="/item/<%= trip.id %>" class="btn btn-secondary btn-sm">Подробнее</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>