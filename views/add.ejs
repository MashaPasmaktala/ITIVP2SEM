<%- include('partials/header', { user: user, title: 'Добавить поездку' }) %>

<h1>Добавить поездку</h1>

<% if (errors && errors.length > 0) { %>
  <div class="error">
    <strong>Ошибки:</strong>
    <ul>
      <% errors.forEach(e => { %>
        <li><%= e %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/add">
  <label>Откуда *</label>
  <input type="text" name="from" value="<%= formData ? formData.from : '' %>" required>

  <label>Куда *</label>
  <input type="text" name="to" value="<%= formData ? formData.to : '' %>" required>

  <label>Дата и время отправления *</label>
  <input type="datetime-local" name="departureAt" value="<%= formData ? formData.departureAt : '' %>" required>

  <label>Цена, BYN * (≥ 0)</label>
  <input type="number" name="price" min="0" step="0.01" value="<%= formData ? formData.price : '' %>" required>

  <label>Количество мест * (≥ 0)</label>
  <input type="number" name="seats" min="0" value="<%= formData ? formData.seats : '' %>" required>

  <label>Рейтинг (0–5)</label>
  <input type="number" name="rating" min="0" max="5" step="0.1" value="<%= formData ? formData.rating : '0' %>">

  <label>Водитель</label>
  <select name="driverId">
    <option value="">— не назначен —</option>
    <% drivers.forEach(d => { %>
      <option value="<%= d.id %>" <%= formData && formData.driverId == d.id ? 'selected' : '' %>><%= d.name %> (<%= d.phone %>)</option>
    <% }) %>
  </select>

  <button type="submit">Добавить</button>
</form>

<%- include('partials/footer') %>